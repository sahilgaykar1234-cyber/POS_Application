rules_version = '2';

// Cafe POS — multi-tenant security rules.
//
// Identity comes from Firebase Auth custom claims {role, cafeId}, which only
// the backend (Cloud Functions / local admin script) can set. A user can never
// change their own role or cafe, and every cafe-scoped path is checked against
// the user's cafeId claim, so one cafe can never read another cafe's data.
//
// Test: cd firestore-tests && npm test   (runs against the local emulator)

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers

    function signedIn() { return request.auth != null; }

    // Logins created in the Super Admin panel have no token claims; their role
    // and cafe are in users/{uid}, which only the Super Admin can write (see
    // /users below). Only manager/captain are ever taken from that document –
    // Super Admin comes from the server-set claim alone.
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasUserDoc() { return signedIn() && exists(userPath()); }
    function docRole() {
      return hasUserDoc() && get(userPath()).data.get('role', '') in ['manager', 'captain']
        ? get(userPath()).data.role : null;
    }
    function claimRole() { return signedIn() ? request.auth.token.get('role', null) : null; }
    function role() { return claimRole() != null ? claimRole() : docRole(); }
    function myCafe() {
      return !signedIn() ? null
        : (request.auth.token.get('cafeId', null) != null ? request.auth.token.cafeId
          : (docRole() != null ? get(userPath()).data.get('cafeId', null) : null));
    }
    // A login turned off by the Super Admin loses access at once.
    function loginActive() { return !hasUserDoc() || get(userPath()).data.get('status', 'active') != 'disabled'; }

    function isSuper() { return claimRole() == 'superAdmin'; }
    function isStaffOf(cafeId) { return role() in ['manager', 'captain'] && myCafe() == cafeId && loginActive(); }
    function isManagerOf(cafeId) { return role() == 'manager' && myCafe() == cafeId && loginActive(); }

    function cafeData(cafeId) { return get(/databases/$(database)/documents/cafes/$(cafeId)).data; }

    // Same policy as lib/core/subscription/cafe_access.dart:
    // cafe active, subscription not expired/suspended, expiry (if any) in future.
    function cafeOperational(cafeId) {
      let c = cafeData(cafeId);
      let sub = c.get('subscription', {});
      let exp = sub.get('expiryDate', null);
      return c.get('status', 'active') == 'active'
        && c.get('legacyData', false) != true
        && !(sub.get('status', 'active') in ['expired', 'suspended'])
        && (exp == null || exp > request.time);
    }

    function canReadCafe(cafeId) { return isSuper() || isStaffOf(cafeId); }
    function canManageCafe(cafeId) { return isSuper() || (isManagerOf(cafeId) && cafeOperational(cafeId)); }

    // ------------------------------------------------------------------ cafes

    match /cafes/{cafeId} {
      allow read: if canReadCafe(cafeId);
      // Creation/deletion/status/subscription changes are Super Admin only.
      allow create, update, delete: if isSuper();

      match /settings/{docId} {
        allow read: if canReadCafe(cafeId);
        allow write: if canManageCafe(cafeId);
      }

      match /categories/{id} {
        allow read: if canReadCafe(cafeId);
        allow write: if canManageCafe(cafeId);
      }
      match /subcategories/{id} {
        allow read: if canReadCafe(cafeId);
        allow write: if canManageCafe(cafeId);
      }
      match /menuItems/{id} {
        allow read: if canReadCafe(cafeId);
        allow write: if canManageCafe(cafeId);
      }

      match /orders/{orderId} {
        allow read: if canReadCafe(cafeId);
        // Managers run the POS: create, edit, bill, complete, delete.
        allow create, update, delete: if isManagerOf(cafeId) && cafeOperational(cafeId);
        // Captains (kitchen screen) may only change the cooking status.
        allow update: if role() == 'captain' && myCafe() == cafeId && loginActive() && cafeOperational(cafeId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'kitchenStatus'])
          && request.resource.data.status in ['pending', 'preparing', 'ready'];
      }

      // Per-cafe counters (daily takeaway token). Managers take orders.
      match /counters/{id} {
        allow read: if canReadCafe(cafeId);
        allow write: if isManagerOf(cafeId) && cafeOperational(cafeId);
      }

      // Anything else under a cafe: Super Admin only.
      match /{other=**} {
        allow read, write: if isSuper();
      }
    }

    // ------------------------------------------------------------------ users
    // Written by the Super Admin (panel) or the admin script (Admin SDK).
    // Nobody can write their own document, and a document can never grant
    // Super Admin.
    match /users/{uid} {
      allow read: if isSuper()
        || (signedIn() && request.auth.uid == uid)
        || (role() == 'manager' && resource.data.cafeId == myCafe());
      allow create, update: if isSuper() && request.auth.uid != uid
        && request.resource.data.role in ['manager', 'captain']
        && request.resource.data.cafeId is string
        && exists(/databases/$(database)/documents/cafes/$(request.resource.data.cafeId));
      allow delete: if isSuper() && request.auth.uid != uid;
    }

    // -------------------------------------------------- SaaS billing (platform)
    match /plans/{planId} {
      allow read: if signedIn();
      allow write: if isSuper();
    }

    match /subscriptionPayments/{paymentId} {
      allow read: if isSuper() || (role() == 'manager' && resource.data.cafeId == myCafe());
      allow write: if isSuper();
    }

    match /counters/{name} {
      allow read, write: if isSuper();
    }

    // Platform-wide settings (trial length, defaults, alerts): Super Admin only.
    match /platform/{doc} {
      allow read, write: if isSuper();
    }

    // --------------------------------------------------------- audit & alerts
    match /auditLogs/{id} {
      allow read: if isSuper() || (role() == 'manager' && resource.data.cafeId == myCafe());
      // Clients may only append entries in their own name; never edit/delete.
      allow create: if signedIn()
        && request.resource.data.actorUid == request.auth.uid
        && (isSuper() || (role() in ['manager', 'captain'] && request.resource.data.cafeId == myCafe()));
      allow update, delete: if false;
    }

    match /notifications/{id} {
      allow read: if isSuper()
        || (role() == 'manager' && resource.data.audience == 'cafe' && resource.data.cafeId == myCafe());
      // Created by the scheduled Cloud Function; readers may only mark as read.
      allow update: if (isSuper() || (role() == 'manager' && resource.data.cafeId == myCafe()))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow create, delete: if isSuper();
    }

    // ------------------------------------------------- legacy (pre-migration)
    // The old shared collections stay intact as a backup. After the migration
    // only the Super Admin can read them and nobody can change them.
    match /orders/{id} {
      allow read: if isSuper();
      allow write: if false;
    }
    match /menu_categories/{id} {
      allow read: if isSuper();
      allow write: if false;
    }
    match /settings/{id} {
      allow read: if isSuper();
      allow write: if false;
    }

    // Everything else is denied by default.
  }
}
